{ pkgs, ... }:
{
  # Головной (без GUI) вариант profiles/media.nix — для машин без графики,
  # которым нужен только разбор видео/аудио. Потребитель здесь pi: его
  # fetch_content вытаскивает кадры и транскрипт из YouTube (нужен yt-dlp +
  # ffmpeg) и из локальных видеофайлов (нужен ffmpeg). В дереве лабораторных
  # это, например, `PASZI/ПАСОИБ DLP.mkv` (1,3 ГБ видеолекция).
  #
  # Почему не media.nix: там GUI-приложения (krita, mpv, vlc, totem,
  # pavucontrol, moonlight-qt, cassette), которых на headless-хосте не с чем
  # запускать, и ffmpeg-full — он тянет X11, SDL, GPU-обвязку и кучу кодеков,
  # которые для «вынуть кадр/дорожку» не нужны.
  #
  # Пока подключено только к forge (hosts/forge/home.nix); на server этот
  # профиль не импортирован — там видео разбирают тем же способом, но
  # необходимость приедет отдельно, если приедет.
  home.packages = with pkgs; [
    yt-dlp

    # ffmpeg 8 без GUI-обвязки. Кадр из видео (`-vf select`, `fps=`), нарезка
    # и склейка, извлечение аудио — всё есть; нет только things-с-экраном
    # (x11grab, drawtext через freetype), которые на headless и не нужны.
    ffmpeg-headless
  ];
}
